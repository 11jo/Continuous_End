// BG2 kits

BEGIN ~Swashbuckler kit for Alora in BG1~
DESIGNATED 101
LABEL ~Continuous_Alora_kit_for_EET~
REQUIRE_PREDICATE GAME_IS ~eet~ ~EET need to be installed.~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Alora.TP2~ ~0~ OR MOD_IS_INSTALLED ~Alora.TP2~ ~1~) ~Alora BG2 need to be installed~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Continuous_End.TP2~ ~0~ OR MOD_IS_INSTALLED ~Continuous_End.TP2~ ~1~) ~Continuous Alora not installed~

// Add Swashbuckler / Bretteur kit to BG1 CRE

//	Regular BG1
ACTION_FOR_EACH creature IN ALORA BEGIN

	ACTION_IF FILE_EXISTS_IN_GAME ~%creature%.cre~ THEN BEGIN

		PRINT ~Alora Exists~
			COPY_EXISTING ~%creature%.cre~ ~override~
					READ_SHORT 0x46 Alora_AC
						WRITE_SHORT 0x46 Alora_AC + 1
						WRITE_SHORT 0x48 Alora_AC + 1
				WRITE_SHORT 0x244 0
				WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~SWASHBUCKLER~)) // SWASHBUCKLER - 0x400C
				LPF ADD_CRE_EFFECT
					INT_VAR
					opcode  = 73
					target  = 2
					parameter1   = 1
					timing  = 9       // Instant/Permanent - 9
					resist_dispel = 2
				END
				LPF ADD_CRE_EFFECT
					INT_VAR
					opcode  = 278
					target  = 2
					parameter1   = 1
					timing  = 9       // Instant/Permanent - 9
					resist_dispel = 2
				END
			BUT_ONLY

	END ELSE BEGIN

		PRINT ~Alora doesn't exists~

	END
END
/*
– +1 bonus to Armor Class at 1st level, plus an additional +1 bonus every 5 levels.
– +1 bonus to hit and damage rolls every 5 levels.
*/


BEGIN ~Alaghor of Clangeddin kit for Yeslick in BG1~
DESIGNATED 109
LABEL ~Continuous_Yeslick_kit_for_EET~
REQUIRE_PREDICATE GAME_IS ~eet~ ~EET need to be installed.~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~YESLICKNPC.TP2~ ~1~)  ~Yeslick as Alaghor of Clangeddin need to be installed~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Continuous_End.TP2~ ~0~ OR MOD_IS_INSTALLED ~Continuous_End.TP2~ ~9~) ~Continuous Yeslick not installed~

// Add Alaghor of Clangeddin kit to BG1 CRE

//	Regular BG1
ACTION_FOR_EACH creature IN YESLIC YESLIC5 BEGIN

	ACTION_IF FILE_EXISTS_IN_GAME ~%creature%.cre~ THEN BEGIN

		PRINT ~Yeslick Exists~
			COPY_EXISTING ~%creature%.cre~ ~override~
				WRITE_SHORT 0x244 0
				WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~LK_ALAGHOR~)) // LK_ALAGHOR - 0x4048
			BUT_ONLY

	END ELSE BEGIN

		PRINT ~Yeslick doesn't exists~

	END
END


BEGIN ~Feralan kit for Kivan in BG1~
DESIGNATED 110
LABEL ~Continuous_Kivan_kit_for_EET~
REQUIRE_PREDICATE GAME_IS ~eet~ ~EET need to be installed.~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~SETUP-KIVAN.TP2~ ~100~)  ~Kivan BG2 need to be installed~
REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~Continuous_End.TP2~ ~0~ OR MOD_IS_INSTALLED ~Continuous_End.TP2~ ~10~) ~Continuous Kivan not installed~
REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~setup-ub~ ~23~) ~Feralan from Unfinished Buisness mod not installed~

// Add Feralan / Sanguinaire kit to BG1 CRE

//	Regular BG1
ACTION_FOR_EACH creature IN KIVAN KIVAN4 KIVAN6 BEGIN

	ACTION_IF FILE_EXISTS_IN_GAME ~%creature%.cre~ THEN BEGIN

		PRINT ~Kivan Exists~
			COPY_EXISTING ~%creature%.cre~ ~override~
				READ_SHORT 0x46 Kivan_AC
			PATCH_IF NOT (~%creature%~ STRING_EQUAL_CASE ~KIVAN6~) BEGIN
					WRITE_SHORT 0x46 Kivan_AC + 1
					WRITE_SHORT 0x48 Kivan_AC + 1
			END ELSE BEGIN
					WRITE_SHORT 0x46 Kivan_AC + 2
					WRITE_SHORT 0x48 Kivan_AC + 2
			END
				READ_SHORT 0x68 Kivan_stealth
					WRITE_SHORT 0x68 Kivan_stealth + 10
				WRITE_SHORT 0x244 0
				WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~FERALAN~))
			BUT_ONLY

	END ELSE BEGIN

		PRINT ~Kivan doesn't exists~

	END
END
/*
-  +10% to Stealth ability
-  Gains +1 AC at first level, and a further bonus of +1 AC per 5 levels
-  May go into a Feral Rage once per day per 10 levels. The enraged state lasts for 60 seconds, and grants a bonus of +2 to hit, damage, and AC, and immunity to charm, hold and fear, maze, imprisonment, stun and sleep. He also gains 15 temporary hit points
-  May cast Call of the Wild once per day. This summons an animal companion who will fight for the caster for 3 rounds + 1 round/level. More powerful creatures are summoned at higher levels
*/