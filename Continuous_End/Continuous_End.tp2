BACKUP ~weidu_external/Continuous_End/backup~
// AUTHOR
SUPPORT ~https://github.com/11jo/Continuous_End/issues~
VERSION ~1.1~

README ~Continuous_End/readme/Continuous_End.txt~

ASK_EVERY_COMPONENT

ALWAYS

	OUTER_SET Continuous_Alora = 0 // DESIGNATED 1

	OUTER_SET Continuous_Ajantis = 0 // DESIGNATED 2 

	OUTER_SET Continuous_Branwen = 0 // DESIGNATED 5

	OUTER_SET Continuous_Coran = 0 // DESIGNATED 4

	OUTER_SET Continuous_Isra = 0 // DESIGNATED 7

	OUTER_SET Continuous_Kivan = 0 // DESIGNATED 10

	OUTER_SET Continuous_Tiax = 0 // DESIGNATED 8

	OUTER_SET Continuous_Xan = 0 // DESIGNATED 3

	OUTER_SET Continuous_Yeslick = 0 // DESIGNATED 9

END


/* ======================= *
 * Continuous NPC for EET  *
 * ======================= */

BEGIN ~Continuous NPC for EET (Install after NPC mods)~
DESIGNATED 0
LABEL ~Continuous_NPC_for_EET~
REQUIRE_PREDICATE GAME_IS ~eet~ ~EET need to be installed.~
REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~EET_End.TP2~ ~0~ AND NOT MOD_IS_INSTALLED ~EET_End.TP2~ ~1~) ~Need to be installed before EET_End~

	OUTER_SET Continuous_Alora = 1

	OUTER_SET Continuous_Ajantis = 1

	OUTER_SET Continuous_Branwen = 1

	OUTER_SET Continuous_Coran = 1

	OUTER_SET Continuous_Isra = 1

	OUTER_SET Continuous_Kivan = 1

	OUTER_SET Continuous_Tiax = 1

	OUTER_SET Continuous_Xan = 1

	OUTER_SET Continuous_Yeslick = 1

		INCLUDE ~Continuous_End/lib/Continuous_BCS.tph~

		INCLUDE ~Continuous_End/lib/Continuous_DLG.tph~

			INCLUDE ~Continuous_End/lib/Continuous_Alora.tph~

			INCLUDE ~Continuous_End/lib/Continuous_Ajantis.tph~

			INCLUDE ~Continuous_End/lib/Continuous_Branwen.tph~

			INCLUDE ~Continuous_End/lib/Continuous_Coran.tph~

			INCLUDE ~Continuous_End/lib/Continuous_Isra.tph~

			INCLUDE ~Continuous_End/lib/Continuous_Kivan.tph~

			INCLUDE ~Continuous_End/lib/Continuous_Tiax.tph~

			INCLUDE ~Continuous_End/lib/Continuous_Xan.tph~

			INCLUDE ~Continuous_End/lib/Continuous_Yeslick.tph~


BEGIN ~Continuous Alora for EET (Install after Alora BG2 mod)~
DESIGNATED 1
LABEL ~Continuous_Alora_for_EET~
REQUIRE_PREDICATE GAME_IS ~eet~ ~EET need to be installed.~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Alora.TP2~ ~0~ OR MOD_IS_INSTALLED ~Alora.TP2~ ~1~) ~Alora BG2 need to be installed~
REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~Continuous_End.TP2~ ~0~) ~All components are already installed~
REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~EET_End.TP2~ ~0~ AND NOT MOD_IS_INSTALLED ~EET_End.TP2~ ~1~) ~Need to be installed before EET_End~

	OUTER_SET Continuous_Alora = 1

		INCLUDE ~Continuous_End/lib/Continuous_BCS.tph~

		INCLUDE ~Continuous_End/lib/Continuous_DLG.tph~

		INCLUDE ~Continuous_End/lib/Continuous_Alora.tph~


