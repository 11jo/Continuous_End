// Wulfgar Barbarian

BEGIN ~Continuous Kit for EET~
DESIGNATED 100
LABEL ~Continuous_Kit_for_EET~
REQUIRE_PREDICATE GAME_IS ~eet~ ~EET need to be installed.~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Continuous_End.TP2~ ~0~) ~Continuous NPC for EET not installed~

OUTER_SET Continuous_Alora_Kit = 1

OUTER_SET Continuous_Kivan_Kit = 1

OUTER_SET Continuous_RoT_Artemis_Kit = 1

OUTER_SET Continuous_RoT_Jarlaxe_Kit = 1

OUTER_SET Continuous_RoT_Bruenor_Kit = 1

OUTER_SET Continuous_RoT_Catti_Kit = 1

OUTER_SET Continuous_RoT_Wulfgar_Kit = 1

OUTER_SET Continuous_Yeslick_Kit = 1

		INCLUDE ~Continuous_End/lib/Continuous_Kit.tph~

/////////////////////////////////////////////////////////////////////////////

BEGIN ~Swashbuckler kit for Alora in BG1~
DESIGNATED 101
LABEL ~Continuous_Alora_kit_for_EET~
REQUIRE_PREDICATE GAME_IS ~eet~ ~EET need to be installed.~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Alora.TP2~ ~0~ OR MOD_IS_INSTALLED ~Alora.TP2~ ~1~) ~Alora BG2 need to be installed~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~Continuous_End.TP2~ ~0~ OR MOD_IS_INSTALLED ~Continuous_End.TP2~ ~1~) ~Continuous Alora not installed~
REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~Continuous_End.TP2~ ~100~) ~Continuous Kit for EET already installed.~

// Add Swashbuckler / Bretteur kit to BG1 CRE

OUTER_SET Continuous_Alora_Kit = 1

		INCLUDE ~Continuous_End/lib/Continuous_Kit.tph~

/*
– +1 bonus to Armor Class at 1st level, plus an additional +1 bonus every 5 levels.
– +1 bonus to hit and damage rolls every 5 levels.
*/

