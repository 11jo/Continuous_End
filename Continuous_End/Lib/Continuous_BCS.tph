// Replace OLD_DEATH_VAR by the Death_var that need to be changed
	// Replace SCRIPT_MOD_NAME by SCRIPT_WHATEVER
		// Replace DIALOG_MOD_NAME by DIALOG_WHATEVER
			// Replace SOUND_MOD_NAME by SOUND_WHATEVER
				// Replace NEW_DEATH_VAR by the new Death_var for your continuous NPC
					// Replace MY_MOD by the tp2 name of your mod
						// Replace MY_COMPONENT by the COMPONENT name of your mod (usually ~0~)

///////////////////////////////////////////////////////////////////////////////

/*
ACTION_IF Continuous_NPC_NAME = 1 AND (MOD_IS_INSTALLED ~MY_MOD_BG1.TP2~ ~MY_MOD_BG1_COMPONANT~ OR MOD_IS_INSTALLED ~MY_MOD_BG2.TP2~ ~MY_MOD_BG2_COMPONANT~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~NPC_NAME_COMPONANT~) BEGIN
