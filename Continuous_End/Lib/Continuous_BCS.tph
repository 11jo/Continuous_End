///////////////////////////////////////////////////////////////////////////////
///////////////// If DEATH_VAR is unique /////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////

// Replace OLD_DEATH_VAR by the Death_var that need to be changed
	// Replace NEW_DEATH_VAR by the new Death_var for your continuous NPC
		// Replace MY_MOD by the tp2 name of your mod
			// Replace MY_COMPONENT by the COMPONENT name of your mod (usually ~0~)

///////////////////////////////////////////////////////////////////////////////
/*
			SPRINT textToReplace ~~~~~"OLD_DEATH_VAR"~~~~~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
			PATCH_IF Continuous_NPC_NAME = 2 AND (num_matches > 0) BEGIN
				REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~~~~~"NEW_DEATH_VAR"~~~~~
				PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
				PATCH_PRINT ~... // %textToReplace% found in %SOURCE_FILESPEC%
				~
			END
	END
*/

	// Alora
ACTION_IF Continuous_Alora = 1 AND (MOD_IS_INSTALLED ~ALORA.TP2~ ~0~ OR MOD_IS_INSTALLED ~Alora.TP2~ ~1~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~1~) BEGIN
	OUTER_SET Continuous_Alora = 2
END
	// Ajantis 
ACTION_IF Continuous_Ajantis = 1 AND (MOD_IS_INSTALLED ~AJANTISBG2.TP2~ ~0~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~2~) BEGIN
	OUTER_SET Continuous_Ajantis = 2
END
	// Xan
ACTION_IF Continuous_Xan = 1 AND (MOD_IS_INSTALLED ~Xan.TP2~ ~0~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~3~) BEGIN
	OUTER_SET Continuous_Xan = 2
END
	// Coran
ACTION_IF Continuous_Coran = 1 AND (MOD_IS_INSTALLED ~CORAN.TP2~ ~0~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~4~) BEGIN
	OUTER_SET Continuous_Coran = 2
END
	// Branwen
ACTION_IF Continuous_Branwen = 1 AND (MOD_IS_INSTALLED ~BRANWEN.TP2~ ~0~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~5~) BEGIN
	OUTER_SET Continuous_Branwen = 2
END
	// Isra
ACTION_IF Continuous_Isra = 1  AND (MOD_IS_INSTALLED ~ISRA.TP2~ ~0~ AND MOD_IS_INSTALLED ~ISRA_BG2.TP2~ ~0~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~7~) BEGIN
	OUTER_SET Continuous_Isra = 2
END
	// Tiax
ACTION_IF Continuous_Tiax = 1 AND (MOD_IS_INSTALLED ~TIAX.TP2~ ~0~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~8~) BEGIN
	OUTER_SET Continuous_Tiax = 2
END
	// Yeslick
ACTION_IF Continuous_Yeslick = 1 AND (MOD_IS_INSTALLED ~YESLICKNPC.TP2~ ~0~ OR MOD_IS_INSTALLED ~YESLICKNPC.TP2~ ~1~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~9~) BEGIN
	OUTER_SET Continuous_Yeslick = 2
END
	// Kivan
ACTION_IF Continuous_Kivan = 1 AND (MOD_IS_INSTALLED ~SETUP-KIVAN.TP2~ ~100~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~10~) BEGIN
	OUTER_SET Continuous_Kivan = 2
END
	// Region_of_Terror
ACTION_IF Continuous_Region_of_Terror = 1 AND (MOD_IS_INSTALLED ~SETUP-ROT.TP2~ ~0~ AND FILE_EXISTS_IN_GAME ~F_JARLAX.cre~) AND NOT (MOD_IS_INSTALLED ~Continuous_End.tp2~ ~11~) BEGIN
	OUTER_SET Continuous_Region_of_Terror = 2
END




//                                    BCS                                           //

	COPY_EXISTING_REGEXP GLOB ~^.+\.bcs$~ ~override~
		DECOMPILE_AND_PATCH BEGIN
	// Alora BG2 START
		PATCH_IF Continuous_Alora = 2 BEGIN
			SPRINT textToReplace ~CreateCreature("CMALORA",\([^)]*\))~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
			PATCH_IF (num_matches > 0) BEGIN
				REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~CreateCreature("CRE_CMALORA",\1)~
				PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
				PATCH_PRINT ~... // %textToReplace% found in %SOURCE_FILESPEC%
				~
			END
			SPRINT textToReplace ~ChangeAIScript("CMALORA",\([^)]*\))~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
			PATCH_IF (num_matches > 0) BEGIN
				REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~ChangeAIScript("SCRIPT_CMALORA",\1)~
				PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
				PATCH_PRINT ~... // %textToReplace% found in %SOURCE_FILESPEC%
				~
			END
			SPRINT textToReplace ~StartDialog\([^)]*\)("CMALORA",\([^)]*\))~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
			PATCH_IF (num_matches > 0) BEGIN
				REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~StartDialog\1("DIALOG_CMALORA",\2)~
				PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
				PATCH_PRINT ~... // %textToReplace% found in %SOURCE_FILESPEC%
				~
			END
			SPRINT textToReplace ~SetDialog\([^)]*\)("CMALORA")~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
			PATCH_IF (num_matches > 0) BEGIN
				REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~SetDialog\1("DIALOG_CMALORA")~
				PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
