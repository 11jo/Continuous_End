
IF
	Global("Continuous_RoT_Enter2","MYAREA",0)
	BeenInParty("F_ARTEMIS")
	!Dead("F_ARTEMIS")
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ActionOverride("F_ARTEMIS",ChangeAIScript("Enter2",OVERRIDE))
		SetGlobal("Continuous_RoT_Enter2","MYAREA",1)
		ActionOverride("F_ARTEMIS",SetGlobal("Continuous_RoT_Enter2","LOCALS",1))
		MoveGlobal("rr4002","F_ARTEMIS",[409.362])
		ActionOverride("F_ARTEMIS",Face(12))
		ApplySpellRES("bdresurr","F_ARTEMIS")
		SmallWait(1)
		ReallyForceSpellDeadRES("bdrejuve","F_ARTEMIS")
		ChangeEnemyAlly("F_ARTEMIS",NEUTRAL)
		ChangeSpecifics("F_ARTEMIS",ALLIES)
		ActionOverride("F_ARTEMIS",SetNumTimesTalkedTo(0))
//		ActionOverride("F_ARTEMIS",ChangeAIScript("",CLASS))
//		ActionOverride("F_ARTEMIS",ChangeAIScript("",RACE))
//		ActionOverride("F_ARTEMIS",ChangeAIScript("",GENERAL))
//		ActionOverride("F_ARTEMIS",ChangeAIScript("",DEFAULT))
		ActionOverride("F_ARTEMIS",SetDialog("Enter2"))
 // Add Enter2.cre items
		ActionOverride("F_ARTEMIS",TakePartyItem("F_CATSBW"))
		ActionOverride("F_ARTEMIS",TakePartyItem("F_CATSWD"))
		ActionOverride("F_ARTEMIS",DestroyItem("F_CATSBW"))
		ActionOverride("F_ARTEMIS",DestroyItem("F_CATSWD"))
		GiveItemCreate("ENTERISA","F_ARTEMIS",0,0,0)
		GiveItemCreate("ENTERISD","F_ARTEMIS",0,0,0)
		GiveItemCreate("ENTERISB","F_ARTEMIS",0,0,0)
		GiveItemCreate("KHARONSN","F_ARTEMIS",0,0,0)
		ActionOverride("F_ARTEMIS",SetItemFlags("ENTERISA",IDENTIFIED,TRUE))
		ActionOverride("F_ARTEMIS",SetItemFlags("ENTERISD",IDENTIFIED,TRUE))
		ActionOverride("F_ARTEMIS",SetItemFlags("ENTERISB",IDENTIFIED,TRUE))
		ActionOverride("F_ARTEMIS",SetItemFlags("KHARONSN",IDENTIFIED,TRUE))
		XEquipItem("ENTERISA","F_ARTEMIS",SLOT_ARMOR,EQUIP)
		XEquipItem("ENTERISD","F_ARTEMIS",SLOT_WEAPON2,EQUIP)
		XEquipItem("ENTERISB","F_ARTEMIS",SLOT_GAUNTLETS,EQUIP)
		XEquipItem("KHARONSN","F_ARTEMIS",SLOT_WEAPON1,EQUIP)
		SetInterrupt(TRUE)
		Continue()
END
