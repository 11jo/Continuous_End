
IF
	Global("Continuous_RoT_Brue2","MYAREA",0)
	BeenInParty("F_BRUENOR")
	!Dead("F_BRUENOR")
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ActionOverride("F_BRUENOR",ChangeAIScript("Brue2",OVERRIDE))
		SetGlobal("Continuous_RoT_Brue2","MYAREA",1)
		ActionOverride("F_BRUENOR",SetGlobal("Continuous_RoT_Brue2","LOCALS",1))
		MoveGlobal("rr3306","F_BRUENOR",[3267.582])
		ActionOverride("F_BRUENOR",Face(2))
		ApplySpellRES("bdresurr","F_BRUENOR")
		SmallWait(1)
		ReallyForceSpellDeadRES("bdrejuve","F_BRUENOR")
		ChangeEnemyAlly("F_BRUENOR",NEUTRAL)
		ChangeSpecifics("F_BRUENOR",ALLIES)
		ActionOverride("F_BRUENOR",SetNumTimesTalkedTo(0))
//		ActionOverride("F_BRUENOR",ChangeAIScript("",CLASS))
//		ActionOverride("F_BRUENOR",ChangeAIScript("",RACE))
//		ActionOverride("F_BRUENOR",ChangeAIScript("",GENERAL))
//		ActionOverride("F_BRUENOR",ChangeAIScript("",DEFAULT))
		ActionOverride("F_BRUENOR",SetDialog("Brue2"))
 // Add BRUE2.cre items
		ActionOverride("F_BRUENOR",TakePartyItem("F_BRUEHL"))
		ActionOverride("F_BRUENOR",DestroyItem("F_BRUEHL"))
		GiveItemCreate("BRUENAX","F_BRUENOR",0,0,0)
		GiveItemCreate("BRUENSH","F_BRUENOR",0,0,0)
		GiveItemCreate("BRUENHE","F_BRUENOR",0,0,0)
		ActionOverride("F_BRUENOR",SetItemFlags("BRUENAX",IDENTIFIED,TRUE))
		ActionOverride("F_BRUENOR",SetItemFlags("BRUENSH",IDENTIFIED,TRUE))
		ActionOverride("F_BRUENOR",SetItemFlags("BRUENHE",IDENTIFIED,TRUE))
		XEquipItem("BRUENAX","F_BRUENOR",SLOT_WEAPON1,EQUIP)
		XEquipItem("BRUENSH","F_BRUENOR",SLOT_SHIELD,EQUIP)
		XEquipItem("BRUENHE","F_BRUENOR",SLOT_HELMET,EQUIP)
		SetInterrupt(TRUE)
		Continue()
END
