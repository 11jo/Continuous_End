
IF
	Global("O#XanSpawned","GLOBAL",0)
	Global("Continuous_BG2_Xan","MYAREA",0)
	OR(2)
		BeenInParty("Xan")
		Exists("Xan")
	!Dead("Xan")
//	!InPartyAllowDead("Xan")
//	!InParty("Xan")
//	!InMyArea("Xan")
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ActionOverride("Xan",ChangeAIScript("O#XanS",OVERRIDE))
		SetGlobal("Continuous_BG2_Xan","MYAREA",1)
SetGlobal("O#XanSpawned","GLOBAL",1) // Original block variable
		ActionOverride("Xan",SetGlobal("Continuous_BG2_Xan","LOCALS",1))
		MoveGlobal("AR1000","Xan",[2745.321])
		ActionOverride("Xan",Face(4))
		ApplySpellRES("bdresurr","Xan")
		SmallWait(1)
		ReallyForceSpellDeadRES("bdrejuve","Xan")
		ChangeEnemyAlly("Xan",NEUTRAL)
		ChangeSpecifics("Xan",ALLIES)
		ActionOverride("Xan",SetNumTimesTalkedTo(0))
//		ActionOverride("Xan",ChangeAIScript("",CLASS))
//		ActionOverride("Xan",ChangeAIScript("",RACE))
//		ActionOverride("Xan",ChangeAIScript("",GENERAL))
//		ActionOverride("Xan",ChangeAIScript("",DEFAULT))
		ActionOverride("Xan",SetDialog("O#Xan"))
		ActionOverride("Xan",TakePartyItem("SW1H13"))
		ActionOverride("Xan",DestroyItem("SW1H13"))
		GiveItemCreate("O#XANMB","Xan",0,0,0)
		GiveItemCreate("POTN20","Xan",5,0,0)
		GiveItemCreate("POTN08","Xan",2,0,0)
		ActionOverride("Xan",SetItemFlags("O#XANMB",IDENTIFIED,TRUE))
		XEquipItem("O#XANMB","Xan",SLOT_WEAPON1,EQUIP)
		SetInterrupt(TRUE)
		Continue()
END
