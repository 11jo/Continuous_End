
IF
	Global("Continuous_BG2_Coran","MYAREA",0)
	OR(2)
		BeenInParty("Coran")
		Exists("Coran")
	!Dead("Coran")
//	!InPartyAllowDead("Coran")
//	!InParty("Coran")
//	!InMyArea("Coran")
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ActionOverride("Coran",ChangeAIScript("O#CoranS",OVERRIDE))
		SetGlobal("Continuous_BG2_Coran","MYAREA",1)
		SetGlobal("O#CoranSpawn","GLOBAL",1)
		ActionOverride("Coran",SetGlobal("Continuous_BG2_Coran","LOCALS",1))
		MoveGlobal("AR0020","Coran",[375.900])
		ApplySpellRES("bdresurr","Coran")
		SmallWait(1)
		ReallyForceSpellDeadRES("bdrejuve","Coran")
		ChangeEnemyAlly("Coran",NEUTRAL)
		ChangeSpecifics("Coran",ALLIES)
		ActionOverride("Coran",SetNumTimesTalkedTo(0))
//		ActionOverride("Coran",SetGlobal("bd_joined","locals",0)) // SoD
//		ActionOverride("Coran",ChangeAIScript("",CLASS))
//		ActionOverride("Coran",ChangeAIScript("",RACE))
//		ActionOverride("Coran",ChangeAIScript("",GENERAL))
//		ActionOverride("Coran",ChangeAIScript("",DEFAULT))
		ActionOverride("Coran",SetDialog("O#Coran"))
		GiveItemCreate("LEAT01","Coran",0,0,0)
		GiveItemCreate("BOW03","Coran",0,0,0)
		GiveItemCreate("AROW01","Coran",20,0,0)
		GiveItemCreate("SW2H01","Coran",0,0,0)
		ActionOverride("Coran",SetItemFlags("SW2H01",IDENTIFIED,TRUE))
		ActionOverride("Coran",SetItemFlags("BOW03",IDENTIFIED,TRUE))
		ActionOverride("Coran",SetItemFlags("LEAT01",IDENTIFIED,TRUE))
		XEquipItem("BOW03","Coran",SLOT_WEAPON1,EQUIP)
		XEquipItem("LEAT01","Coran",SLOT_ARMOR,EQUIP)
		SetInterrupt(TRUE)
		Continue()
END
