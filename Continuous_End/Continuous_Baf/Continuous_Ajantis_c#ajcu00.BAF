IF
	BeenInParty("Ajantis")
THEN
    RESPONSE #100
	CutSceneId(Player1)
	ClearAllActions()
	Wait(5)
	CreateCreature("C#KNIG03",[-1.-1],6)
	CreateCreature("C#KNIG01",[-1.-1],6)
	CreateVisualEffectObject("C#AJGKEX","C#KNIG03")
	ActionOverride("C#KNIG03",Polymorph(FIGHTER_FEMALE_HUMAN))
	CreateVisualEffectObject("C#AJGKEX","C#KNIG01")
	ActionOverride("C#KNIG01",Polymorph(FIGHTER_FEMALE_HUMAN))
	Wait(1)
	CreateCreature("C#KNIG04",[-1.-1],3)
	CreateCreature("C#KNIG02",[-1.-1],0)
	CreateVisualEffectObject("C#AJGKEX","C#KNIG04")
	ActionOverride("C#KNIG04",Polymorph(FIGHTER_FEMALE_HUMAN))
	CreateVisualEffectObject("C#AJGKEX","C#KNIG02")
	ActionOverride("C#KNIG02",Polymorph(FIGHTER_FEMALE_HUMAN))
	Wait(1)
		ActionOverride("Ajantis",ChangeAIScript("C#AJAN",OVERRIDE))
		SetGlobal("Continuous_BG2_Ajantis","MYAREA",1)
		ActionOverride("Ajantis",SetGlobal("Continuous_BG2_Ajantis","LOCALS",1))
		MoveGlobal("AR0319","Ajantis",[-1.-1])
	CreateVisualEffectObject("C#AJGKEX","Ajantis")
		ActionOverride("Ajantis",Face(9))
		ApplySpellRES("bdresurr","Ajantis")
		SmallWait(1)
		ReallyForceSpellDeadRES("bdrejuve","Ajantis")
		ChangeEnemyAlly("Ajantis",NEUTRAL)
		ChangeSpecifics("Ajantis",ALLIES)
		ActionOverride("Ajantis",SetNumTimesTalkedTo(0))
//		ActionOverride("Ajantis",SetGlobal("bd_joined","locals",0)) // SoD
//		ActionOverride("Ajantis",ChangeAIScript("",CLASS))
//		ActionOverride("Ajantis",ChangeAIScript("",RACE))
//		ActionOverride("Ajantis",ChangeAIScript("",GENERAL))
//		ActionOverride("Ajantis",ChangeAIScript("",DEFAULT))
		ActionOverride("Ajantis",SetDialog("C#AJAN"))
 // Add C#Ajan08.cre items
		GiveItemCreate("C#AJSHLD","Ajantis",0,0,0)
		GiveItemCreate("SW1H02","Ajantis",0,0,0)
		GiveItemCreate("PLAT01","Ajantis",0,0,0)
		GiveItemCreate("HELM01","Ajantis",0,0,0)
		GiveItemCreate("POTN52","Ajantis",5,0,0)
		ActionOverride("Ajantis",SetItemFlags("C#AJSHLD",IDENTIFIED,TRUE))
		ActionOverride("Ajantis",SetItemFlags("SW1H02",IDENTIFIED,TRUE))
		ActionOverride("Ajantis",SetItemFlags("PLAT01",IDENTIFIED,TRUE))
		ActionOverride("Ajantis",SetItemFlags("HELM01",IDENTIFIED,TRUE))
		XEquipItem("C#AJSHLD","Ajantis",SLOT_SHIELD,EQUIP)
		XEquipItem("SW1H02","Ajantis",SLOT_WEAPON1,EQUIP)
		XEquipItem("PLAT01","Ajantis",SLOT_ARMOR,EQUIP)
		XEquipItem("HELM01","Ajantis",SLOT_HELMET,EQUIP)
 // Add C#Ajan08.cre items
	Wait(3)
	SetGlobal("C#AjantisExistiert","GLOBAL",1)
	SetGlobal("C#AjantisDirektErschaffen","GLOBAL",1)
	EndCutSceneMode()
	ActionOverride("Ajantis",StartDialogueNoSet(Player1))
END
