
IF
	Global("Continuous_BG2_Kivan","MYAREA",0)
	OR(2)
		BeenInParty("Kivan")
		Exists("Kivan")
	!Dead("Kivan")
//	!InPartyAllowDead("Kivan")
//	!InParty("Kivan")
//	!InMyArea("Kivan")
Global("P#KIVANExists","Global",0)
!Global("X#TalkedToKivan","GLOBAL",1)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ActionOverride("Kivan",ChangeAIScript("P#KIV01",OVERRIDE))
		SetGlobal("Continuous_BG2_Kivan","MYAREA",1)
SetGlobal("P#KIVANExists","Global",1) // Original block variable
		ActionOverride("Kivan",SetGlobal("Continuous_BG2_Kivan","LOCALS",1))
		MoveGlobal("%Kivan_ARE%","Kivan",[%Kivan_LOC%])
		ActionOverride("Kivan",Face(3))
		ApplySpellRES("bdresurr","Kivan")
		SmallWait(1)
		ReallyForceSpellDeadRES("bdrejuve","Kivan")
		ChangeEnemyAlly("Kivan",NEUTRAL)
		ChangeSpecifics("Kivan",ALLIES)
		ActionOverride("Kivan",SetNumTimesTalkedTo(0))
		ActionOverride("Kivan",ChangeAIScript("P#KIVAN",CLASS))
//		ActionOverride("Kivan",ChangeAIScript("",RACE))
//		ActionOverride("Kivan",ChangeAIScript("",GENERAL))
//		ActionOverride("Kivan",ChangeAIScript("",DEFAULT))
		ActionOverride("Kivan",SetDialog("P#KIVAN"))
 // Add O#Kivan.cre items
		GiveItemCreate("SW1H04","Kivan",0,0,0)
		GiveItemCreate("SHLD05","Kivan",0,0,0)
		GiveItemCreate("X#KISPEA","Kivan",0,0,0)
		GiveItemCreate("P#BOW00","Kivan",0,0,0)
		GiveItemCreate("LEAT04","Kivan",0,0,0)
		GiveItemCreate("P#HOOD","Kivan",0,0,0)
		GiveItemCreate("AROW11","Kivan",20,0,0)
		ActionOverride("Kivan",SetItemFlags("SW1H04",IDENTIFIED,TRUE))
		ActionOverride("Kivan",SetItemFlags("SHLD05",IDENTIFIED,TRUE))
		ActionOverride("Kivan",SetItemFlags("X#KISPEA",IDENTIFIED,TRUE))
		ActionOverride("Kivan",SetItemFlags("P#BOW00",IDENTIFIED,TRUE))
		ActionOverride("Kivan",SetItemFlags("LEAT04",IDENTIFIED,TRUE))
		ActionOverride("Kivan",SetItemFlags("P#HOOD",IDENTIFIED,TRUE))
		XEquipItem("X#KISPEA","Kivan",SLOT_WEAPON3,EQUIP)
		XEquipItem("LEAT04","Kivan",SLOT_ARMOR,EQUIP)
		XEquipItem("P#HOOD","Kivan",SLOT_HELMET,EQUIP)
 // Add O#Kivan.cre items
		SetInterrupt(TRUE)
		Continue()
END
