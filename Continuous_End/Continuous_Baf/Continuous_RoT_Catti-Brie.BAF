
IF
	Global("Continuous_RoT_Catti-Brie","MYAREA",0)
	OR(2)
		BeenInParty("F_CATTIBR")
		Exists("F_CATTIBR")
	!Dead("F_CATTIBR")
//	!InPartyAllowDead("F_CATTIBR")
//	!InParty("F_CATTIBR")
//	!InMyArea("F_CATTIBR")
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ActionOverride("F_CATTIBR",ChangeAIScript("CATT2",OVERRIDE))
		SetGlobal("Continuous_RoT_Catti-Brie","MYAREA",1)
		ActionOverride("F_CATTIBR",SetGlobal("Continuous_RoT_Catti-Brie","LOCALS",1))
		MoveGlobal("MYAREA","F_CATTIBR",[-1.-1])
		Deactivate("F_CATTIBR")
		ApplySpellRES("bdresurr","F_CATTIBR")
		SmallWait(1)
		ReallyForceSpellDeadRES("bdrejuve","F_CATTIBR")
		ChangeEnemyAlly("F_CATTIBR",NEUTRAL)
		ChangeSpecifics("F_CATTIBR",ALLIES)
		ActionOverride("F_CATTIBR",SetNumTimesTalkedTo(0))
//		ActionOverride("F_CATTIBR",ChangeAIScript("",CLASS))
//		ActionOverride("F_CATTIBR",ChangeAIScript("",RACE))
//		ActionOverride("F_CATTIBR",ChangeAIScript("",GENERAL))
//		ActionOverride("F_CATTIBR",ChangeAIScript("",DEFAULT))
		ActionOverride("F_CATTIBR",SetDialog("Catt2"))
 // Add O#Xan09.cre items
		ActionOverride("F_CATTIBR",TakePartyItem("F_CATSBW"))
		ActionOverride("F_CATTIBR",TakePartyItem("F_CATSWD"))
		ActionOverride("F_CATTIBR",DestroyItem("F_CATSBW"))
		ActionOverride("F_CATTIBR",DestroyItem("F_CATSWD"))
		GiveItemCreate("CABOW2","F_CATTIBR",0,0,0)
		GiveItemCreate("KHAZID","F_CATTIBR",0,0,0)
		GiveItemCreate("CABOW","F_CATTIBR",0,0,0)
		ActionOverride("F_CATTIBR",SetItemFlags("CABOW2",IDENTIFIED,TRUE))
		ActionOverride("F_CATTIBR",SetItemFlags("KHAZID",IDENTIFIED,TRUE))
		ActionOverride("F_CATTIBR",SetItemFlags("CABOW",IDENTIFIED,TRUE))
		XEquipItem("CABOW2","F_CATTIBR",SLOT_WEAPON1,EQUIP)
		XEquipItem("KHAZID","F_CATTIBR",SLOT_WEAPON3,EQUIP)
		XEquipItem("CABOW","F_CATTIBR",SLOT_WEAPON2,EQUIP)
		ActionOverride("F_CATTIBR",DestroySelf())
		SetInterrupt(TRUE)
		Continue()
END

IF
	Global("Continuous_RoT_Catti-Brie","MYAREA",0)
	!Exists("F_CATTIBR")
	!BeenInParty("F_CATTIBR")
	!Dead("F_CATTIBR")
	!InMyArea("F_CATTIBR")
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("Continuous_RoT_Catti-Brie","MYAREA",1)
		CreateCreature("Catt2",[-1.-1],0)
		Deactivate("F_CATTIBR")
		ActionOverride("F_CATTIBR",ChangeAIScript("CATT2",OVERRIDE))
		ActionOverride("F_CATTIBR",SetGlobal("Continuous_RoT_Catti-Brie","LOCALS",1))
		ActionOverride("F_CATTIBR",DestroySelf())
		SetInterrupt(TRUE)
		Continue()
END
